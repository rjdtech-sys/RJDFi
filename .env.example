# RJD PisoWiFi Management System - Environment Configuration
# Copy this file to .env and fill in your actual values

# ========================================
# Supabase Configuration (for Licensing)
# ========================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
CLOUD_LICENSE_URL=https://rjdfi-cloud-license.vercel.app

# IMPORTANT:
# - DO NOT use the service_role key here
# - Only use the anon/public key
# - This key is safe to use on the device
# - Supabase RLS policies protect the data

# ========================================
# Optional Configuration
# ========================================
# NODE_ENV=production
# PORT=80

# ========================================
# Security: Hardware API Key
# ========================================
# Generate a random key for NodeMCU firmware authentication.
# Run: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Add the same key to your NodeMCU firmware as X-Hardware-Key header.
HARDWARE_API_KEY=change-me-to-a-random-32-char-hex-string
